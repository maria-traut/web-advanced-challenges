{% macro inputField(label, placeholder, type) %} 
<div class="form-floating">
  {% if type == "textarea" %}
  <textarea class="form-control" id="{{label}}" placeholder="{{placeholder}}" style="height: 12rem" data-sb-validations="required"></textarea>
{% else %}
  <input
                    class="form-control"
                    id="{{label}}"
                    type="{{type}}"
                    placeholder="{{placeholder}}"
                    data-sb-validations="required"
                  />
                  {% endif %}
                  <label for="{{label}}">{{label}}</label>
                  <div
                    class="invalid-feedback"
                    data-sb-feedback="{{label}}:required"
                  >
                    A {{label}} is required.
                  </div>
                  </div>
{% endmacro %}
